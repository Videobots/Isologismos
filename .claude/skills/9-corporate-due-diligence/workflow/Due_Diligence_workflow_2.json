          "parent": "1",
          "metadata": {
            "mermaidData": "{\n  \"data\": \"graph TD\\n    %% ΟΡΙΣΜΟΣ ΦΑΣΕΩΝ (SUBGRAPHS)\\n    \\n    subgraph Phase_1 [ΦΑΣΗ 1: Παράλληλη Ανάκτηση Δεδομένων & ETL]\\n        direction TB\\n        DB1[(ERP System: SAP/Oracle)]\\n        DB2[(CRM System: Salesforce)]\\n        API1[/Bank API: Ταμειακές Ροές/]\\n        DOC1[/PDFs: Ισολογισμοί & Συμβάσεις/]\\n        \\n        ETL[Μηχανισμός ETL & AI Data Extraction: Ενοποίηση Δεδομένων]\\n        \\n        DB1 --> ETL\\n        DB2 --> ETL\\n        API1 --> ETL\\n        DOC1 --> ETL\\n    end\\n\\n    subgraph Phase_2 [ΦΑΣΗ 2: Διασταύρωση & Συμφωνία Δεδομένων]\\n        direction TB\\n        RECON_DEC{\\\"Είναι τα δεδομένα Συμφωνημένα; (Reconciliation Check)\\\"}\\n        RECON_FIX[Manual Adjustments: Επικοινωνία με Πελάτη για διορθώσεις]\\n        DATA_READY([Εγκεκριμένο Data Lake για Ανάλυση])\\n        \\n        ETL --> RECON_DEC\\n        RECON_DEC -->|ΟΧΙ: Ασυμφωνία| RECON_FIX\\n        RECON_FIX -->|Επανατροφοδότηση Δεδομένων| ETL\\n        RECON_DEC -->|ΝΑΙ: 100% Match| DATA_READY\\n    end\\n\\n    subgraph Phase_3 [ΦΑΣΗ 3: Παράλληλη Οικονομική Ανάλυση]\\n        direction TB\\n        FORK_1((Διακλάδωση))\\n        \\n        AN_FIN[Financial Analysis: Δείκτες, Ρευστότητα, Κεφάλαιο Κίνησης]\\n        AN_OP[Operational Analysis: Περιθώρια Ανά Πελάτη, CRM Churn]\\n        AN_RISK[Compliance & Risk: Έλεγχος Συμβάσεων & Επισφαλειών]\\n        \\n        DATA_READY --> FORK_1\\n        FORK_1 --> AN_FIN\\n        FORK_1 --> AN_OP\\n        FORK_1 --> AN_RISK\\n    end\\n\\n    subgraph Phase_4 [ΦΑΣΗ 4: Δέντρο Στρατηγικής Αξιολόγησης]\\n        direction TB\\n        RED_FLAG_DEC{\\\"Εντοπίστηκε Κρίσιμος Κίνδυνος / Απάτη;\\\"}\\n        \\n        GOING_CONCERN_DEC{\\\"Βιωσιμότητα: Είναι η εταιρεία Going Concern;\\\"}\\n        \\n        VAL_DCF[Αποτίμηση DCF: Προεξόφληση Μελλοντικών Ταμειακών Ροών]\\n        VAL_LIQ[Αποτίμηση Liquidation: Εκποίηση Περιουσιακών Στοιχείων]\\n        \\n        CRISIS_JUMP[Άμεση Διακοπή Ανάλυσης: Σήμανση Red Flag]\\n        \\n        AN_RISK --> RED_FLAG_DEC\\n        AN_FIN --> GOING_CONCERN_DEC\\n        AN_OP --> GOING_CONCERN_DEC\\n        \\n        RED_FLAG_DEC -->|ΝΑΙ: Κρίσιμο Εύρημα| CRISIS_JUMP\\n        RED_FLAG_DEC -->|ΟΧΙ: Καθαρό| GOING_CONCERN_DEC\\n        \\n        GOING_CONCERN_DEC -->|ΝΑΙ: Υγιής / Αναστρέψιμη| VAL_DCF\\n        GOING_CONCERN_DEC -->|ΟΧΙ: Τεχνική Πτώχευση| VAL_LIQ\\n    end\\n\\n    subgraph Phase_5 [ΦΑΣΗ 5: Σύνθεση & Review Workflow]\\n        direction TB\\n        SYNTHESIS[AI Agent: Σύνθεση Ευρημάτων & Συγγραφή Προσχεδίου]\\n        REVIEW_DEC{\\\"Review Partner: Εγκρίνεται το Προσχέδιο;\\\"}\\n        REVISIONS[Agent: Εφαρμογή Διορθώσεων / Re-prompt]\\n        \\n        FINAL_REPORT([Τελικό Financial Due Diligence Report])\\n        \\n        VAL_DCF --> SYNTHESIS\\n        VAL_LIQ --> SYNTHESIS\\n        \\n        %% Non-Sequential Jump (Παράκαμψη)\\n        CRISIS_JUMP -->|Bypass Valuation| SYNTHESIS\\n        \\n        SYNTHESIS --> REVIEW_DEC\\n        REVIEW_DEC -->|ΟΧΙ: Απαιτούνται Αλλαγές| REVISIONS\\n        REVISIONS -->|Επιστροφή για νέα Σύνθεση| SYNTHESIS\\n        \\n        REVIEW_DEC -->|ΝΑΙ: Τελική Έγκριση| FINAL_REPORT\\n    end\\n\\n    %% ΣΤΥΛΙΣΤΙΚΗ ΔΙΑΜΟΡΦΩΣΗ (Χρώματα ανάλογα με τη λειτουργία)\\n    classDef database fill:#e1f5fe,stroke:#0277bd,stroke-width:2px;\\n    classDef process fill:#f5f5f5,stroke:#424242,stroke-width:2px,rx:5,ry:5;\\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\\n    classDef parallel fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,rx:5,ry:5;\\n    classDef alert fill:#ffebee,stroke:#c62828,stroke-width:3px,rx:5,ry:5;\\n    classDef endpoint fill:#f3e5f5,stroke:#6a1b9a,stroke-width:3px,rx:10,ry:10;\\n\\n    class DB1,DB2,API1,DOC1,DATA_READY database;\\n    class ETL,RECON_FIX,AN_FIN,AN_OP,AN_RISK,SYNTHESIS,REVISIONS process;\\n    class RECON_DEC,RED_FLAG_DEC,GOING_CONCERN_DEC,REVIEW_DEC,FORK_1 decision;\\n    class VAL_DCF,VAL_LIQ parallel;\\n    class CRISIS_JUMP alert;\\n    class FINAL_REPORT endpoint;\",\n  \"config\": null,\n  \"version\": \"12\"\n}"
          }
        },
